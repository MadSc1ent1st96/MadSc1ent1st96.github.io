<div class="card mt-3 p-3">
  <div>
    {% for item in data[1] %}
      <div class="row mb-2">

        <div class="col-sm-3">
          <b>{{ item.name }}</b>
        </div>

        <div class="col-sm-9">
          {% for keyword in item.keywords %}
            {{ keyword }}{% unless forloop.last %}, {% endunless %}
          {% endfor %}
        </div>

      </div>
    {% endfor %}
  </div>
</div>