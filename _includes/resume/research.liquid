<div class="card mt-3 p-3">
  <div>
    {% for item in data[1] %}
      <div class="row mb-2">

        <div class="col-sm-3">
          <h6 class="mb-0">{{ item.name }}</h6>
        </div>

        <div class="col-sm-9">

          <div class="text-muted mb-1">
            {{ item.startDate }} – {{ item.endDate }}
          </div>

          <div class="mb-1">
            {{ item.summary }}
          </div>

          {% if item.highlights %}
          <ul class="cv-highlights">
            {% for h in item.highlights %}
            <li>{{ h }}</li>
            {% endfor %}
          </ul>
          {% endif %}

          {% if item.url %}
          <a href="{{ item.url }}" target="_blank">
            {{ item.url }}
          </a>
          {% endif %}

        </div>

      </div>
    {% endfor %}
  </div>
</div>