<div class="card mt-3 p-3">
  <div>
    {% for item in data[1] %}
      <div class="row mb-2">

        <div class="col-sm-2">
          <span class="badge badge-info">{{ item.year }}</span>
        </div>

        <div class="col-sm-10">

          <div>
            <b>{{ item.name }}</b>
          </div>

          {% if item.status %}
          <div class="text-muted">
            {{ item.status }}
          </div>
          {% endif %}

          {% if item.notes %}
          <div class="text-muted">
            {{ item.notes }}
          </div>
          {% endif %}

        </div>

      </div>
    {% endfor %}
  </div>
</div>